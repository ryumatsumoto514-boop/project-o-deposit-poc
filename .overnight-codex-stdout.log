// Custom geometric mark — a segmented ring (three arcs, radar/telemetry-
// sweep style) around a solid core dot, rendered in the single brand
// accent (Hyper Turquoise). Deliberately not a generic rounded-square
// letter badge: the segmentation reads as "signal/reconciliation," in
// keeping with the app's actual subject (an engine reconciling signals
// across two chains).
export function LogoMark({ className }: { className?: string }) {
  return (
    <svg viewBox="0 0 32 32" className={className} aria-hidden="true">
      <rect x="0.5" y="0.5" width="31" height="31" rx="7" fill="#0d1015" stroke="rgba(255,255,255,0.15)" />
      <circle
        cx="16"
        cy="16"
        r="9.5"
        fill="none"
        stroke="#00F0FF"
        strokeWidth="2.25"
        strokeDasharray="10 4.2"
        strokeLinecap="round"
        transform="rotate(-90 16 16)"
      />
      <circle cx="16" cy="16" r="2.25" fill="#00F0FF" />
    </svg>
  );
}

export function Brand({ compact = false }: { compact?: boolean }) {
  return (
    <div className="flex min-w-0 items-center gap-2.5">
      <LogoMark className="h-8 w-8 shrink-0" />
      <span
        className={`brand-word truncate text-[13px] text-slate-100 ${
          compact ? "hidden" : ""
        }`}
      >
        Exchange O
      </span>
    </div>
  );
}
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --background: #0a0c10;
  --foreground: #e7ecf2;
}

@layer base {
  html {
    color-scheme: dark;
  }
  body {
    color: var(--foreground);
    background-color: #0a0c10;
    /* Dot-matrix telemetry texture (fine, low-opacity grid) plus one
       restrained accent glow at the very top of the page — a cryptographic
       telemetry surface, not a marketing hero. */
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      radial-gradient(720px circle at 50% 0%, rgba(0, 240, 255, 0.1), transparent 60%);
    background-size: 22px 22px, 100% 100%;
    background-position: -11px -11px, 0 0;
    background-attachment: fixed, fixed;
    font-family: var(--font-sans), ui-sans-serif, system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }
}

@layer components {
  .page-shell {
    @apply mx-auto flex w-full max-w-md min-h-[calc(100dvh-56px)] flex-col justify-start gap-5 px-5 pt-10 pb-8 sm:pt-14;
  }
  /* Wider variant for the landing page only — the asymmetric hero and
     pipeline sections need real horizontal room on desktop; every other
     screen (forms, the status tracker) stays on the narrower .page-shell
     since those are single-column flows, not a marketing layout. */
  .page-shell-wide {
    @apply mx-auto flex w-full max-w-6xl flex-col gap-14 px-5 pb-16 pt-10 sm:px-8 sm:pt-14 lg:px-10;
  }

  /* Cards — razor-sharp 1px borders at 0.15 opacity, flat opaque surface,
     tight radius. Reads as a data-product panel, not a glassy marketing
     card. */
  .card {
    @apply rounded-lg border border-white/[0.15] bg-[#10131a] p-4 shadow-[0_1px_0_rgba(255,255,255,0.03)_inset,0_10px_24px_-14px_rgba(0,0,0,0.7)];
  }
  .card-flush {
    @apply rounded-lg border border-white/[0.15] bg-[#10131a];
  }

  /* Buttons */
  .btn {
    @apply relative inline-flex min-h-[46px] items-center justify-center gap-2 overflow-hidden rounded-md px-5 text-sm font-semibold tracking-tight transition-all duration-150 disabled:cursor-not-allowed disabled:opacity-40 active:scale-[0.98];
  }
  /* Tactile "hover glint" — a light sweep across the button on hover,
     pure CSS (background-position transition), no JS/animation library. */
  .btn-primary {
    @apply btn bg-accent-500 text-[#03181c] shadow-[0_1px_0_rgba(255,255,255,0.35)_inset,0_8px_20px_-6px_rgba(0,240,255,0.45)] hover:bg-accent-400 disabled:bg-accent-500;
    background-image: linear-gradient(
      110deg,
      transparent 0%,
      transparent 40%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 60%,
      transparent 100%
    );
    background-size: 250% 100%;
    background-position: 100% 0;
    transition: background-position 0.5s ease, background-color 0.15s ease;
  }
  .btn-primary:hover {
    background-position: -20% 0;
  }
  .btn-secondary {
    @apply btn justify-start border border-white/[0.15] bg-white/[0.03] text-slate-200 hover:border-white/25 hover:bg-white/[0.06] active:bg-white/[0.08];
  }
  .btn-danger {
    @apply btn bg-rose-600 text-white shadow-[0_8px_20px_-6px_rgba(225,29,72,0.5)] hover:bg-rose-500;
  }
  .btn-warning {
    @apply btn bg-amber-400 text-amber-950 shadow-[0_8px_20px_-6px_rgba(251,191,36,0.4)] hover:bg-amber-300;
  }

  /* Inputs */
  .input {
    @apply min-h-[46px] w-full rounded-md border border-white/[0.15] bg-black/30 px-3.5 text-[15px] text-slate-100 outline-none transition-colors placeholder:text-slate-600 focus:border-accent-400/60 focus:ring-4 focus:ring-accent-500/15;
  }

  /* Banners — severity coding stays strictly distinct from the brand
     accent: amber = warning, rose = error, emerald = success, accent
     (turquoise) = informational/mocked-disclosure, never used for warnings
     or errors so the two systems never collide. */
  .banner {
    @apply rounded-lg border px-4 py-3 text-[13px] leading-relaxed;
  }
  .banner-amber {
    @apply banner border-amber-400/25 bg-amber-400/[0.08] text-amber-200;
  }
  .banner-accent {
    @apply banner border-accent-400/25 bg-accent-400/[0.08] text-accent-200;
  }
  .banner-red {
    @apply banner border-rose-400/25 bg-rose-400/[0.08] text-rose-200;
  }
  .banner-green {
    @apply banner border-emerald-400/25 bg-emerald-400/[0.08] text-emerald-200;
  }

  /* Typography */
  .h1 {
    @apply text-[22px] font-semibold tracking-tight text-slate-50 sm:text-2xl;
  }
  .h1-hero {
    @apply text-[36px] font-bold leading-[1.04] tracking-tight text-slate-50 sm:text-[52px];
  }
  .eyebrow {
    @apply font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-accent-400/90;
  }
  .brand-word {
    @apply font-mono font-semibold uppercase tracking-[0.1em];
  }
  .label-caps {
    @apply text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500;
  }
  .body-text {
    @apply text-[14px] leading-relaxed text-slate-400;
  }
  .mono-box {
    @apply break-all rounded-md border border-white/[0.15] bg-black/40 p-3 font-mono text-[13px] text-slate-300;
  }
  a {
    @apply text-accent-400 transition-colors hover:text-accent-300;
  }

  /* App shell header — trading-terminal chrome */
  .app-header {
    @apply sticky top-0 z-20 border-b border-white/[0.1] bg-[#0a0c10]/90 backdrop-blur-md;
  }
  .pill {
    @apply inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-md border border-white/[0.15] bg-white/[0.03] px-2.5 py-1 font-mono text-[11px] font-medium uppercase tracking-wide text-slate-400;
  }

  /* Status tag — "Zero Unlimited Allowances" / "Real-time Exception
     Handling" style crisp micro-copy chips with a glowing LED status dot. */
  .tag {
    @apply inline-flex shrink-0 items-center gap-2 rounded-md border border-white/[0.15] bg-white/[0.03] px-2.5 py-1.5 font-mono text-[11px] font-medium uppercase tracking-wide text-slate-300;
  }

  /* Live telemetry ticker line on the hero */
  .ticker {
    @apply inline-flex items-center gap-2 rounded-md border border-white/[0.15] bg-black/30 px-3 py-2 font-mono text-[12px] tracking-wide text-accent-300;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
}

/* LED-style status dots — solid core + soft currentColor glow, used on
   nav pills, status tags, and pipeline nodes. */
.led-dot {
  @apply relative inline-block h-1.5 w-1.5 shrink-0 rounded-full;
  box-shadow: 0 0 6px 1px currentColor;
}
.led-dot.led-live::after {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 9999px;
  background: currentColor;
  opacity: 0.5;
  animation: led-pulse 1.8s ease-out infinite;
}
@keyframes led-pulse {
  0% {
    transform: scale(0.6);
    opacity: 0.55;
  }
  100% {
    transform: scale(1.9);
    opacity: 0;
  }
}

@keyframes pulse-ring {
  0% {
    box-shadow: 0 0 0 0 rgba(0, 240, 255, 0.45);
  }
  100% {
    box-shadow: 0 0 0 10px rgba(0, 240, 255, 0);
  }
}

.pulse-ring {
  animation: pulse-ring 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-up {
  animation: fade-up 0.35s ease-out both;
}

@keyframes success-pop {
  0% {
    opacity: 0;
    transform: scale(0.8);
  }
  60% {
    opacity: 1;
    transform: scale(1.06);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.success-pop {
  animation: success-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* Reconciliation-engine hero visual: dots flowing along each pipeline
   connector, left to right, staggered per-connector so it reads as
   continuous throughput rather than one repeating blip. */
@keyframes flow-dot {
  0% {
    left: -6%;
    opacity: 0;
  }
  8% {
    opacity: 1;
  }
  92% {
    opacity: 1;
  }
  100% {
    left: 100%;
    opacity: 0;
  }
}

.flow-dot {
  animation: flow-dot 2.2s linear infinite;
}

@keyframes node-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(0, 240, 255, 0.35);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(0, 240, 255, 0);
  }
}

.node-pulse {
  animation: node-pulse 2.4s ease-in-out infinite;
}

/* Honor the device accessibility preference across decorative motion and
   loading indicators. Text status remains visible without animation. */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }

  .flow-dot,
  .led-dot.led-live::after {
    display: none;
  }

  .btn:active {
    transform: none;
  }
}
"use client";

import { useFlow } from "../flow-context";
import { ShieldIcon } from "./icons";

// UX improvement #5: persistent compliance/trust disclosure, not a
// marketing widget. Reads from flow state so it survives navigation even
// once the ?ref= param is gone from the URL.
export function KolBanner() {
  const { kolRef } = useFlow();
  if (!kolRef) return null;

  return (
    <div className="banner-amber flex w-full items-start gap-2.5">
      <ShieldIcon className="mt-0.5 h-4 w-4 shrink-0 text-amber-300" />
      <span className="text-amber-100/90">
        You arrived via <strong className="text-amber-100">{kolRef}</strong>&apos;s
        content. Exchange O is independent — deposit and trading decisions
        are yours alone.
      </span>
    </div>
  );
}

export function MockedBadge({ children }: { children: React.ReactNode }) {
  return (
    <div className="banner-accent w-full">
      <strong>Mocked for this PoC:</strong> {children}
    </div>
  );
}

