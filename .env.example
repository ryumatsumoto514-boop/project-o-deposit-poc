# Copy to .env.local and fill in.
#
# Private key for the testnet-only relayer wallet that simulates "the
# deposit contract" pulling approved USDC via transferFrom(). Generate with:
#   node -e "const{generatePrivateKey,privateKeyToAccount}=require('viem/accounts');const k=generatePrivateKey();console.log(k, privateKeyToAccount(k).address)"
# Fund the resulting address with a trivial amount of Arbitrum Sepolia ETH
# (gas only) via a public faucet. NEVER use a key that holds real funds.
ARBITRUM_RELAYER_PRIVATE_KEY=
NEXT_PUBLIC_DEPOSIT_ADDRESS=

# Optional: override the default public Arbitrum Sepolia RPC endpoint
# (recommended for production — e.g. an Alchemy/Infura Arbitrum Sepolia URL).
ARBITRUM_SEPOLIA_RPC_URL=
